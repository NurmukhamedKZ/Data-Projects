    "from dotenv import load_dotenv\n",
    "from openai import OpenAI\n",
    "import os\n",
    "import json\n",
    "import time\n",
    "\n",
    "load_dotenv()\n",
    "\n",
    "OpenAI_API = os.getenv(\"AIML_API\")\n",
    "\n",
    "client = OpenAI(\n",
    "    base_url=\"https://api.aimlapi.com/v1\",\n",
    "    api_key=OpenAI_API,\n",
    ")\n",
    "\n",
    "def create_question():\n",
    "  message = [{\"role\": \"system\",\n",
    "              \"content\": \"\"\"\n",
    "              you are the best creator of UNT(kazakh national exam) Kazakh history questions in Kazakhstan. you have to make question in kazakh language\n",
    "              \n",
    "              Return the question in the following JSON structure:\n",
    "              {\n",
    "                \"title\": \"The question title\",\n",
    "                \"options\": [\"Option 1\", \"Option 2\", \"Option 3\", \"Option 4\"],\n",
    "                \"correct_answer_id\": 0, // Index of the correct answer (0-3)\n",
    "                \"explanation\": \"Detailed explanation of why the correct answer is right\"\n",
    "              }\n",
    "\n",
    "              Make sure the options are plausible but with only one clearly correct answer.\n",
    "              \n",
    "              \"\"\"},\n",
    "            {\"role\": \"user\",\n",
    "            \"content\": \"generate one kazakh history question\"}]\n",
    "\n",
    "  try:\n",
    "    response = client.chat.completions.create(\n",
    "        model=\"google/gemma-3-12b-it\",\n",
    "        messages=message,\n",
    "        temperature=0.7,\n",
    "        response_format={\"type\": \"json_object\"}\n",
    "    )\n",
    "\n",
    "\n",
    "    message = response.choices[0].message.content\n",
    "    json_message = json.loads(message)\n",
    "    required_titles = [\"title\",\"options\",\"correct_answer_id\",\"explanation\"]\n",
    "    for title in required_titles:\n",
    "      if title not in json_message:\n",
    "        raise ValueError(f\"Missing required field: {title}\")\n",
    "    return json_message\n",
    "  except Exception as e:\n",
    "    print(e)\n",
    "    return None\n"
   ]
  },
